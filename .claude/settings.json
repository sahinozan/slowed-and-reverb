{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:whitespace)",
      "Bash(npm run lint:firefox)",
      "Bash(npm test *)",
      "Bash(npm run check)",
      "Bash(npm run checks:for *)",
      "Bash(npm run checks:tables)",
      "Bash(npm run site:popup)",
      "Bash(npm run site:stamp)",
      "Bash(npm run build:chromium)",
      "Bash(npm run build:firefox)",
      "Bash(npm run package)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test:ui *)"
    ],
    "ask": [
      "Edit(audit-exceptions.json)"
    ],
    "deny": [
      "Bash(npm audit fix)",
      "Bash(npm audit fix *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/refuse-generated-edit.js"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/regenerate.js"]
          }
        ]
      }
    ]
  }
}
