{
  "manifest_version": 3,
  "name": "Slowed & Reverb",
  "version": "1.0.0",
  "description": "Apply real-time slowed, reverb, and related audio effects to HTML5 media on supported pages. Fully local with zero telemetry.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://open.spotify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16-off.png",
      "48": "assets/icon48-off.png",
      "128": "assets/icon128-off.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-effect": {
      "description": "Toggle last preset"
    },
    "toggle-slowed-reverb": {
      "description": "Toggle Slowed + Reverb preset"
    },
    "toggle-nightcore": {
      "description": "Toggle Nightcore preset"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
