{
  "name": "slowed-reverb-extension",
  "version": "1.0.1",
  "description": "Slowed + Reverb and Nightcore for YouTube\u2122, YouTube Music\u2122 and Spotify. Change the speed, reverb, bass and more. Free and private.",
  "private": true,
  "scripts": {
    "build:chromium": "node scripts/build-extension.js chromium",
    "build:firefox": "node scripts/build-extension.js firefox",
    "check": "npm run lint && npm test && npm run lint:firefox",
    "icons": "node scripts/render-icons.js",
    "lint": "eslint . --max-warnings=0",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir=dist/firefox --no-config-discovery",
    "package": "npm run package:chromium && npm run package:firefox",
    "package:chromium": "npm run build:chromium && web-ext build --source-dir=dist/chromium --artifacts-dir=dist/packages --filename=slowed-reverb-chromium.zip --overwrite-dest --no-config-discovery",
    "package:firefox": "npm run build:firefox && web-ext build --source-dir=dist/firefox --artifacts-dir=dist/packages --filename=slowed-reverb-firefox.zip --overwrite-dest --no-config-discovery",
    "site:popup": "node scripts/sync-site-popup.js",
    "store:assets": "node scripts/render-store-assets.js",
    "test": "node --test --test-concurrency=1",
    "test:e2e": "npm run build:chromium && playwright test",
    "test:watch": "node --test --test-concurrency=1 --watch"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "adm-zip": "0.6.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "web-ext": "10.7.0"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "license": "MIT"
}
