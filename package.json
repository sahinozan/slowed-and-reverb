{
  "name": "slowed-reverb-extension",
  "version": "1.0.0",
  "description": "Apply real-time slowed and reverb audio effects to any HTML5 media element.",
  "private": true,
  "scripts": {
    "build:firefox": "node scripts/build-firefox.js",
    "check": "npm run lint && npm test && npm run lint:firefox",
    "lint": "eslint .",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir=dist/firefox --no-config-discovery",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --test-concurrency=1 --watch"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "web-ext": "10.6.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "SEE LICENSE IN README.md"
}
